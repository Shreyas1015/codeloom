      "css": ".ds-btn-primary{height:36px;padding:8px 16px;border:0;border-radius:6px;background:var(--primary,#1F4D45);color:#fff;font:600 14px 'Schibsted Grotesk',sans-serif;cursor:pointer;transition:background .15s}.ds-btn-primary:hover{background:rgb(31 77 69 / .9)}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 2px var(--ring,#8F6410)}"
    },
