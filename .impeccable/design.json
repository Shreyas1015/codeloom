    {
      "name": "Stop Roundel",
      "kind": "custom",
      "refersTo": "stop-roundel",
      "description": "The ochre audio-guide number of one journey stop; selected adds a halo.",
      "html": "<span class=\"ds-roundel\">5</span> <span class=\"ds-roundel ds-roundel--selected\">6</span> <span class=\"ds-roundel ds-roundel--unresolved\">7</span>",
      "css": ".ds-roundel{display:inline-grid;place-items:center;width:24px;height:24px;border-radius:9999px;border:1.5px solid var(--accent,#E3A72F);background:var(--accent,#E3A72F);color:var(--accent-foreground,#3A2A06);font:600 11px/1 'JetBrains Mono',monospace;font-variant-numeric:tabular-nums}.ds-roundel--selected{border-color:var(--accent-foreground,#3A2A06);box-shadow:0 0 0 4px rgb(227 167 47 / .35)}.ds-roundel--unresolved{background:#fff;border-style:dashed;border-color:var(--destructive,#B5483D);color:var(--destructive,#B5483D)}"
    },
    {
      "name": "Home Stop Row",
      "kind": "custom",
      "refersTo": "stop-roundel-hollow",
      "description": "A journey's stops on Home: hollow roundels ringed in their lane hue, +N past eight.",
      "html": "<span class=\"ds-row\"><span class=\"ds-h ds-ui\">1</span><i></i><span class=\"ds-h ds-ui\">2</span><i></i><span class=\"ds-h ds-api\">3</span><i></i><span class=\"ds-h ds-db\">4</span><i></i><span class=\"ds-h ds-more\">+3</span></span>",
      "css": ".ds-row{display:inline-flex;align-items:center}.ds-row i{width:6px;height:1px;background:var(--connector,#94804E)}.ds-h{display:inline-grid;place-items:center;min-width:22px;height:22px;border-radius:9999px;border:1.5px solid;background:#fff;font:600 10px/1 'JetBrains Mono',monospace}.ds-ui{border-color:#2F5E9E;color:#2F5E9E}.ds-api{border-color:#1F4D45;color:#1F4D45}.ds-db{border-color:#8A5A2B;color:#8A5A2B}.ds-more{border-style:dashed;border-color:#5C6661;color:#5C6661;padding:0 4px}"
    },
    {
      "name": "Stop Card in a Lane",
      "kind": "card",
      "refersTo": "stop-card",
      "description": "One stop on the Journey lanes: roundel, two-line name, path that wraps at slashes.",
      "html": "<div class=\"ds-lane\"><div class=\"ds-lane-h\"><b>API</b><code>api</code></div><button class=\"ds-stop\"><span class=\"ds-roundel\">4</span><span><b>POST /api/customers</b><code>start/routes.ts:7</code></span></button></div>",
      "css": ".ds-lane{background:var(--lane-api-soft,#E0ECE8);border-radius:10px;padding:10px;width:184px}.ds-lane-h{display:flex;justify-content:space-between;color:var(--lane-api,#1F4D45);font:700 12.5px 'Schibsted Grotesk',sans-serif;margin-bottom:12px}.ds-lane-h code{font:400 12px 'JetBrains Mono',monospace}.ds-stop{display:flex;gap:8px;align-items:flex-start;width:100%;text-align:left;background:#fff;border:1px solid var(--border,#D9DDD8);border-radius:9px;padding:8px 10px;box-shadow:0 1px 2px rgb(20 40 35 / .06);cursor:pointer;transition:border-color .15s}.ds-stop:hover{border-color:#5C6661}.ds-stop:focus-visible{outline:2px solid var(--ring,#8F6410);outline-offset:2px}.ds-stop b{display:block;font:600 13px/1.3 'Schibsted Grotesk',sans-serif;color:#1A1D1C}.ds-stop code{display:block;font:400 11.5px/1.35 'JetBrains Mono',monospace;color:#5C6661}.ds-stop .ds-roundel{display:inline-grid;place-items:center;flex:none;width:24px;height:24px;border-radius:9999px;background:#E3A72F;color:#3A2A06;font:600 11px/1 'JetBrains Mono',monospace}"
    },
    {
      "name": "Count Strip",
      "kind": "custom",
      "refersTo": "count",
      "description": "Six workspace totals on a hairline grid under a 2px ink rule.",
      "html": "<ul class=\"ds-strip\"><li><b>23</b><span>Files</span></li><li><b>3</b><span>UI pages</span></li><li><b>5</b><span>API routes</span></li></ul>",
      "css": ".ds-strip{display:grid;grid-template-columns:repeat(3,1fr);list-style:none;margin:0;padding:0;border-top:2px solid var(--foreground,#1A1D1C);border-bottom:1px solid var(--border,#D9DDD8)}.ds-strip li{display:flex;flex-direction:column;gap:2px;padding:11px 16px;border-right:1px solid var(--border,#D9DDD8)}.ds-strip li:last-child{border-right:0}.ds-strip b{font:700 24px/1.25 'Schibsted Grotesk',sans-serif;letter-spacing:-.02em;font-variant-numeric:tabular-nums}.ds-strip span{font:400 12.5px 'Schibsted Grotesk',sans-serif;color:var(--muted-foreground,#5C6661)}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
